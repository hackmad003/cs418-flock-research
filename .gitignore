# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Jupyter autosave copies
.ipynb_checkpoints/

# Raw datasets: full files are too large to track.
# Tracked samples live in data/processed/samples/ (scripts/create_dataset_samples.py).
data/raw/*
!data/raw/.gitkeep

# External geographic data (TIGER/Line boundaries, Chicago files): large files,
# some rebuilt by fetch scripts, some obtained manually. Keep the folder skeleton.
data/external/**
!data/external/**/
!data/external/**/.gitkeep


# Secrets
.env


# Claude Code and Graphify local files
.claude/
graphify-out/